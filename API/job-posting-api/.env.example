# Public LOCAL DEVELOPMENT defaults only. Compose works without a .env file.
# Optionally copy to ignored .env and change ports/passwords before FIRST initialization.
POSTGRES_USER=jobposting
POSTGRES_DB=job_postings
POSTGRES_PASSWORD=local-development-only-change-me
RABBITMQ_DEFAULT_USER=jobposting
RABBITMQ_DEFAULT_PASS=local-development-only-change-me

# Published ports bind only to 127.0.0.1; change these if occupied.
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
JOB_POSTING_API_PORT=5000
JOB_POSTING_TIME_ZONE=America/Toronto
