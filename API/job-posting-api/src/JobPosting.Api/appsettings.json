{
  "JobPosting": {
    "BusinessTimeZone": "America/Toronto",
    "MaximumRequestBodyBytes": 65536
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Resilience": {
    "FailureRatio": 0.5,
    "SamplingSeconds": 60,
    "MinimumThroughput": 3,
    "BreakSeconds": 15
  }
}
